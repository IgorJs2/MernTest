{
  "name": "full-stack-programm",
  "version": "1.0.0",
  "description": "Train develop programm",
  "main": "copybook.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node copybook.js",
    "server": "nodemon copybook.js",
    "client": "npm run start --prefix clients",
    "client:install": "npm install --prefix clients",
    "client:build": "npm run build --prefix clients",
    "dev": "cross-env NODE_ENV=development concurrently \" npm run server \" \" npm run client\""
  },
  "keywords": [
    "full-stack",
    "mern"
  ],
  "author": "Igor Urmach",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "config": "^3.3.6",
    "express": "^4.17.1",
    "express-validator": "^6.12.1",
    "jsonwebtoken": "^8.5.1",
    "jwt-check-expiration": "^1.0.5",
    "mongoose": "^6.0.5",
    "shortid": "^2.2.16"
  },
  "devDependencies": {
    "concurrently": "^6.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^2.0.12"
  }
}
